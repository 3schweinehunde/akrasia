<%= live_component Grid,
      id: :weighings,
      options: @options,
      config:  %{heading: "Listing Weighings",
                 records_getter: &Akrasia.Accounts.list_weighings/1,
                 path_helper: :weighing_path},
      columns: [
        %{field: :id,
          name: "ID",
          searchable: true},
        %{field: :date,
          name: "Date",
          searchable: true},
        %{field: :weight,
          name: "Weight",
          searchable: true},
        %{field: :abdominal_girth,
          name: "Abdominal girth",
          searchable: true},
        %{field: :adipose,
          name: "Adipose",
          searchable: true},
        %{field: :user_id,
          name: "User Id",
          searchable: true},
        %{field: :user_email,
          name: "User Email",
          presenter: &Akrasia.Accounts.Weighing.user_email/1}
      ] %>
